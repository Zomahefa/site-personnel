# ── Site ──
NEXT_PUBLIC_SITE_URL=https://zo-mahefa-it.vercel.app

# ── Admin (messages + audience) ──
# Minimum 12 caractères, avec majuscules, chiffres et symboles.
ADMIN_PASSWORD=

# ── Base de données (Turso / libSQL) ──
# Sans ces variables, une base SQLite locale est utilisée (data/portfolio.db).
TURSO_DB_URL=
TURSO_DB_TOKEN=

# ── Assistant IA ──
# groq (rapide) ou google (Gemini)
AI_PROVIDER=groq
GROQ_API_KEY=
GOOGLE_AI_API_KEY=
